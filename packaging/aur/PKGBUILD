# Maintainer: luis alberto gomez <luisalgomez111 at github>
pkgname=puntero
pkgver=0.2.0
pkgrel=1
pkgdesc="Modern app to configure Logitech mice and keyboards (battery, DPI, buttons, Easy-Switch) using Solaar"
arch=('any')
url="https://github.com/luisalgomez111/puntero"
license=('GPL-3.0-or-later')
depends=('python' 'solaar' 'python-evdev' 'python-gobject' 'gtk4' 'libadwaita>=1.7')
optdepends=('wtype: type texts with accents and symbols from a button (Wayland)'
            'xdotool: type texts with accents and symbols from a button (X11)')
install=puntero.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('da532428a20e982a9995d176c5afd7d6a77d938620abc8108bdf43ef622bb7ee')

package() {
  cd "$pkgname-$pkgver"
  local lib="$pkgdir/usr/lib/puntero"

  install -d "$lib" "$pkgdir/usr/share/puntero"
  cp -r puntero "$lib/"
  cp -r omarchy-plugin "$pkgdir/usr/share/puntero/"
  install -m755 data/omarchy-plugin.sh "$lib/omarchy-plugin.sh"
  find "$lib" -name __pycache__ -type d -prune -exec rm -rf {} +
  python -m compileall -q -d /usr/lib/puntero "$lib/puntero"

  install -Dm755 data/puntero-launcher.sh "$pkgdir/usr/bin/puntero"

  install -d "$pkgdir/usr/lib/systemd/user"
  sed -e "s|@APPDIR@|/usr/lib/puntero|" -e "s|@PYTHON@|/usr/bin/python3|" \
    data/puntero.service >"$pkgdir/usr/lib/systemd/user/puntero.service"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/puntero.desktop" <<DESKTOP
[Desktop Entry]
Version=1.0
Name=Puntero
Comment=Configure your Logitech mice and keyboards
Comment[es]=Controla tus ratones y teclados Logitech
Exec=puntero
Icon=input-mouse
Terminal=false
Type=Application
Categories=Settings;HardwareSettings;
StartupWMClass=ve.puntero.Puntero
DESKTOP

  install -Dm644 -t "$pkgdir/usr/share/doc/puntero" README.md README.es.md
}
