{
  "schemaVersion": 1,
  "id": "puntero.mouse",
  "name": "Puntero",
  "version": "0.2.0",
  "author": "Puntero",
  "license": "GPL-3.0-or-later",
  "description": "Battery, DPI, buttons and Easy-Switch for your Logitech mice, using the Puntero service.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Puntero",
    "description": "Battery and quick settings for your Logitech mouse.",
    "category": "System",
    "aliases": ["mouse", "raton", "logitech", "battery"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showPercentage": true
    },
    "schema": [
      { "key": "showPercentage", "type": "boolean", "label": "Show battery percentage", "defaultValue": true }
    ]
  }
}
